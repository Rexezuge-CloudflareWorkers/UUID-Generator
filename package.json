{
  "name": "@uuid-generator/monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "postinstall": "pnpm run prepare-wrangler-config && pnpm run cf-typegen",
    "predeploy": "pnpm run buildApp && pnpm run cf-typegen",
    "deploy": "pnpm exec wrangler deploy --config ./apps/api/wrangler.jsonc",
    "dev": "pnpm exec wrangler dev --config ./apps/api/wrangler.jsonc",
    "start": "pnpm run dev",
    "build": "pnpm -r build",
    "buildApp": "pnpm --filter @uuid-generator/web run release",
    "cf-typegen": "pnpm exec wrangler types --config ./apps/api/wrangler.jsonc --env-interface CloudflareEnv",
    "checks": "pnpm -r typecheck && pnpm --filter @uuid-generator/web lint && pnpm run test",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "clean": "rm -rf apps/web/dist",
    "prepare-wrangler-config": "pnpm exec tsx scripts/prepare-wrangler-config.ts",
    "prettier": "prettier --write .",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.x",
    "tsx": "^4.23.x",
    "typescript": "^6.0.x",
    "vitest": "^5.0.x",
    "wrangler": "^4.131.x"
  }
}
